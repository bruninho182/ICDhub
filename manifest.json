{
  "manifest_version": 3,
  "name": "ICD Hub",
  "version": "3.7.1",
  "description": "Ferramentas de atendimento da Ingresso com Desconto: atalhos WhatsApp, reservas, cotações, vouchers e e-mails.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://admin.tourcms.com/*",
    "https://www.ingressocomdesconto.com.br/*",
    "https://*.ingressocomdesconto.com.br/*",
    "https://app.icdgrupo.com.br/*",
    "https://*.postimg.cc/*",
    "https://wa.me/*",
    "https://*.whatsapp.com/*",
    "https://web.whatsapp.com/*",
    "https://supplier.getyourguide.com/*",
    "https://webmail-seguro.com.br/*",
    "https://webmail.locaweb.com.br/*",
    "https://admin.ticketgotourism.com/*",
    "https://report.ingressocomdesconto.com.br/adm/paginas/*",
    "https://*.ingressocomdesconto.com.br/adm/paginas/*",
    "*://navio.ingressocomdesconto.com.br/*",
    "*://*.ingressocomdesconto.com.br/*",
    "https://yqlvdvilddobvangvvva.supabase.co/*",
    "https://dash.pagar.me/*",
    "https://api.pagar.me/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.civitatis.com/*",
        "https://app.icdgrupo.com.br/apps/sales/bookings/*",
        "https://admin.ticketgotourism.com/*",
        "*://navio.ingressocomdesconto.com.br/*",
        "https://admin.tourcms.com/admin/bookings/bookings_edit.php?bid=*",
        "https://supplier.getyourguide.com/bookings/*",
        "https://web.whatsapp.com/*",
        "*://*.ingressocomdesconto.com.br/*",
        "https://app.icdgrupo.com.br/*",
        "https://webmail-seguro.com.br/*",
        "https://webmail.locaweb.com.br/*",
        "https://www.ingressocomdesconto.com.br/adm/paginas/relatorio_previsaovisitas.asp*",
        "https://report.ingressocomdesconto.com.br/adm/paginas/relatorio_passaportesE.asp?emp=*",
        "https://ingressocomdesconto.com.br/adm/paginas/relatorio_passaportesE.asp?emp=*",
        "https://www.ingressocomdesconto.com.br/adm/paginas/voucher.asp*",
        "https://dash.pagar.me/*"
      ],
      "js": [
        "scripts/generated/diagnostico.js",
        "scripts/generated/funcionalidades.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.civitatis.com/*"
      ],
      "js": [
        "scripts/pdf.min.js",
        "scripts/pdf.worker.min.js",
        "scripts/civitatis_bridge.js"
      ]
    },
    {
      "matches": [
        "https://app.icdgrupo.com.br/apps/sales/bookings/*"
      ],
      "js": [
        "scripts/generated/operacao_review.js",
        "scripts/generated/reserva_date.js",
        "scripts/generated/fornecedor_map.js",
        "scripts/generated/ota_prepare.js",
        "scripts/generated/cotacao.js",
        "scripts/generated/tarifario_import.js",
        "scripts/generated/disponibilidade_import.js",
        "scripts/remarcacao_tool.js",
        "scripts/icd_sheet_icdgrupo.js",
        "scripts/generated/voucher_review.js",
        "scripts/enviar_voucher.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://admin.ticketgotourism.com/*"
      ],
      "js": [
        "scripts/ticketgo_bridge.js"
      ]
    },
    {
      "matches": [
        "*://navio.ingressocomdesconto.com.br/*"
      ],
      "js": [
        "scripts/navio_bridge.js"
      ]
    },
    {
      "matches": [
        "https://admin.tourcms.com/admin/bookings/bookings_edit.php?bid=*"
      ],
      "js": [
        "scripts/grayline_extract.js"
      ]
    },
    {
      "matches": [
        "https://supplier.getyourguide.com/bookings/*"
      ],
      "js": [
        "scripts/generated/reserva_date.js",
        "scripts/generated/fornecedor_map.js",
        "scripts/generated/reserva_review.js",
        "scripts/generated/gyg.js"
      ]
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "scripts/metrics.js",
        "scripts/generated/cotacao.js",
        "scripts/generated/cotacao_ui.js",
        "scripts/whatsapp_tool.js"
      ],
      "css": [
        "styles/whatsapp.css"
      ]
    },
    {
      "matches": [
        "*://*.ingressocomdesconto.com.br/*",
        "https://app.icdgrupo.com.br/*"
      ],
      "js": [
        "scripts/ingresso_master.js",
        "scripts/metrics.js",
        "scripts/voucher_tracker.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "https://webmail-seguro.com.br/*",
        "https://webmail.locaweb.com.br/*"
      ],
      "js": [
        "scripts/generated/operacao_review.js",
        "scripts/metrics.js",
        "scripts/generated/email_compose.js",
        "scripts/mail_tool.js"
      ]
    },
    {
      "matches": [
        "https://www.ingressocomdesconto.com.br/adm/paginas/relatorio_previsaovisitas.asp*",
        "https://report.ingressocomdesconto.com.br/adm/paginas/relatorio_passaportesE.asp?emp=*",
        "https://ingressocomdesconto.com.br/adm/paginas/relatorio_passaportesE.asp?emp=*"
      ],
      "js": [
        "scripts/generated/email_template.js",
        "scripts/generated/operacao_review.js",
        "scripts/generated/relatorio_email.js"
      ]
    },
    {
      "matches": [
        "https://www.ingressocomdesconto.com.br/adm/paginas/voucher.asp*"
      ],
      "js": [
        "scripts/generated/operacao_review.js",
        "scripts/generated/voucher_review.js",
        "scripts/enviar_voucher.js"
      ]
    },
    {
      "matches": [
        "https://dash.pagar.me/*"
      ],
      "js": [
        "scripts/icd_pagarme_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dash.pagar.me/*"
      ],
      "js": [
        "scripts/generated/operacao_review.js",
        "scripts/icd_sheet_pagarme.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/pdf.min.js",
        "scripts/pdf.worker.min.js"
      ],
      "matches": [
        "*://*.civitatis.com/*"
      ]
    },
    {
      "resources": [
        "icon.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
